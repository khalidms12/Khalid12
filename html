  <style>
    /* الخطوط */
    @import url('https://fonts.googleapis.com/css2?family=Cairo&display=swap');

    body {
      margin: 0;
      font-family: 'Cairo', sans-serif;
      background-color: #f5f5f2;
      color: #1a1a1a;
      direction: rtl;
    }

    /* زخرفة أندلسية خلفية الهيدر */
    header {
      background: #003366 url('https://upload.wikimedia.org/wikipedia/commons/9/99/Islamic_pattern_2.svg') repeat;
      background-size: 80px 80px;
      padding: 20px 40px;
      color: #ffd966;
      text-align: center;
      position: relative;
    }

    header h1 {
      font-size: 2.5rem;
      margin: 0;
      font-weight: bold;
      text-shadow: 0 0 5px #ffd966;
    }

    /* شريط اللغة */
    .lang-select {
      position: absolute;
      left: 20px;
      top: 20px;
      background: #ffd966;
      color: #003366;
      border-radius: 5px;
      padding: 5px 10px;
      font-weight: bold;
      cursor: pointer;
    }

    /* القائمة الرئيسية */
    nav {
      background-color: #0a3d62;
      display: flex;
      justify-content: center;
      gap: 30px;
      padding: 12px 0;
      font-weight: 600;
      font-size: 1.1rem;
    }

    nav a {
      color: #ffd966;
      text-decoration: none;
      transition: color 0.3s;
    }

    nav a:hover {
      color: #fff;
    }

    /* القسم الرئيسي */
    main {
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 20px;
    }

    main h2 {
      color: #003366;
      border-bottom: 3px solid #ffd966;
      padding-bottom: 8px;
      margin-bottom: 15px;
    }

    /* قسم أسئلة اليوم */
    .questions {
      background-color: #e6f0ff;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 40px;
      box-shadow: 0 0 10px rgba(0,51,102,0.1);
    }

    .questions p {
      font-size: 1.2rem;
      line-height: 1.5;
      margin-bottom: 10px;
    }

    .questions strong {
      color: #003366;
    }

    /* روابط سريعة */
    .quick-links {
      display: flex;
      gap: 25px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .quick-links a {
      flex: 1 1 200px;
      background: #ffd966;
      color: #003366;
      text-align: center;
      padding: 20px;
      border-radius: 12px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 0 8px #d4af37;
      transition: background 0.3s;
    }

    .quick-links a:hover {
      background: #e6c94d;
    }

    /* الفوتر */
    footer {
      background: #003366;
      color: #ffd966;
      text-align: center;
      padding: 20px 10px;
      font-size: 0.9rem;
      margin-top: 50px;
      font-weight: 600;
    }

    footer a {
      color: #ffd966;
      text-decoration: none;
      font-weight: bold;
    }

    /* دعم اللغة */
    [lang="ar"] {
      direction: rtl;
      font-family: 'Cairo', sans-serif;
    }
  </style>
</head>
